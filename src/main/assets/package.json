{
  "name": "bootique-release-ui",
  "description": "Bootique.io release automation tool - web UI",
  "version": "1.0.0",
  "repository": "https://github.com/bootique-tools/release",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:watch": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}

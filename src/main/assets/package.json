{
  "name": "bootique-release-ui",
  "description": "Bootique.io release automation tool - web UI",
  "version": "1.0.0",
  "repository": "https://github.com/bootique-tools/release",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:watch": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.102.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
